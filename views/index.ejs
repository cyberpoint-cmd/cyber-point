<!DOCTYPE html>
<html lang="en">

<head>
    <title>CyberPoint - Online Digital Service Portal Bihar</title>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="CyberPoint provides Aadhar Update, New PAN Card, PAN Correction, Income Certificate, Caste Certificate, Residence Certificate and online digital services in Bihar.">
    <meta name="keywords" content="CyberPoint, PAN Card, Aadhar Update, Bihar Online Service, PAN Correction, Digital Service Portal">
    <meta name="author" content="CyberPoint">
    <meta name="robots" content="index, follow">
    <meta property="og:title" content="CyberPoint - Online Digital Service Portal Bihar">
    <meta property="og:description" content="Online PAN, Aadhar and Digital Services Portal">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://cyber-point.onrender.com">
    <link rel="canonical" href="https://cyber-point.onrender.com">

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        * {
            font-family: 'Poppins', sans-serif;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: #eef6ff;
            overflow-x: hidden;
            color: #0f172a;
        }

        .page-shell {
            max-width: 1500px;
            margin: 42px auto;
            background: #ffffff;
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 25px 80px rgba(15, 23, 42, 0.18);
            border: 1px solid rgba(15, 23, 42, 0.08);
        }

        .nav-link {
            position: relative;
            transition: 0.25s ease;
        }

        .nav-link::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: -7px;
            width: 0;
            height: 3px;
            border-radius: 50px;
            background: #0d6dcc;
            transition: 0.25s ease;
        }

        .nav-link:hover,
        .nav-link.active {
            color: #0d6dcc;
        }

        .nav-link:hover::after,
        .nav-link.active::after {
            width: 100%;
        }

        .hero-bg {
            background:
                radial-gradient(circle at 85% 35%, rgba(6, 182, 212, 0.28), transparent 23%),
                linear-gradient(120deg, #06175f 0%, #0a3f91 48%, #087fd1 100%);
        }

        .search-box {
            box-shadow: 0 18px 40px rgba(15, 23, 42, 0.18);
        }

        .btn-primary {
            background: linear-gradient(135deg, #09c7dd, #0f74d1);
            color: white;
            box-shadow: 0 15px 35px rgba(8, 127, 209, 0.30);
            transition: 0.28s ease;
        }

        .btn-primary:hover {
            transform: translateY(-4px);
            box-shadow: 0 22px 45px rgba(8, 127, 209, 0.42);
        }

        .btn-outline {
            border: 2px solid #16c7df;
            color: #10bcd4;
            transition: 0.28s ease;
        }

        .btn-outline:hover {
            background: #16c7df;
            color: #071738;
            transform: translateY(-4px);
        }

        .service-card {
            background: white;
            border: 1px solid #e5edf7;
            box-shadow: 0 14px 34px rgba(15, 23, 42, 0.12);
            transition: 0.28s ease;
        }

        .service-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 24px 50px rgba(15, 23, 42, 0.18);
        }

        .icon-circle {
            background: #e7f8ff;
        }

        .right-card {
            background: #ffffff;
            box-shadow: 0 18px 45px rgba(15, 23, 42, 0.14);
            border: 1px solid #e8eef7;
        }

        .mini-link {
            background: white;
            border: 1px solid #e8eef7;
            box-shadow: 0 12px 28px rgba(15, 23, 42, 0.10);
            transition: 0.25s ease;
        }

        .mini-link:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 42px rgba(15, 23, 42, 0.16);
        }

        .float-soft {
            animation: floatSoft 4s ease-in-out infinite;
        }

        @keyframes floatSoft {
            0%, 100% {
                transform: translateY(0);
            }
            50% {
                transform: translateY(-12px);
            }
        }

        .fade-up {
            animation: fadeUp 0.8s ease forwards;
        }

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(18px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media(max-width: 1024px) {
            .page-shell {
                margin: 0;
                border-radius: 0;
            }
        }

        @media(max-width: 768px) {
            .hero-bg {
                min-height: auto;
            }
        }
    </style>
</head>

<body>

    <div class="page-shell">

        <!-- NAVBAR -->

        <header class="bg-white px-5 md:px-16 py-6 flex items-center justify-between gap-5">

            <a href="/" class="flex items-center gap-2">
                <h1 class="text-2xl md:text-3xl font-black text-[#09245f] tracking-wide">
                    <%= settings && settings.shopName ? settings.shopName : "CYBER POINT" %>
                </h1>
                <span class="w-3 h-3 bg-cyan-400 rounded-full"></span>
            </a>

            <nav class="hidden lg:flex items-center gap-8 font-semibold text-gray-800">
                <a href="/" class="nav-link active">Home</a>
                <a href="/services" class="nav-link">Services</a>
                <a href="/status-check" class="nav-link">Status Check</a>
                <a href="/contact" class="nav-link">Contact</a>
                <a href="/admin/login" class="nav-link">Admin Login</a>
            </nav>

            <a href="https://wa.me/<%= settings && settings.whatsappNumber ? settings.whatsappNumber : '' %>"
                target="_blank"
                class="hidden md:inline-flex px-6 py-3 rounded-lg bg-orange-500 text-white font-bold hover:bg-orange-600 transition">
                WhatsApp/Call ☎
            </a>

            <a href="/status-check"
                class="lg:hidden px-4 py-3 rounded-xl bg-[#0d6dcc] text-white font-bold text-sm">
                Status
            </a>

        </header>

        <!-- HERO -->

        <section class="hero-bg px-5 md:px-16 py-16 md:py-24 grid lg:grid-cols-2 gap-12 items-center">

            <div class="fade-up">

                <h2 class="text-4xl md:text-6xl font-black text-white leading-tight">
                    घर बैठे ऑनलाइन सरकारी सेवाएं
                </h2>

                <p class="text-white/90 text-lg md:text-xl mt-5">
                    Aadhaar, PAN, Certificate, Ration Card और Digital Services अब आसान
                </p>

                <div class="search-box bg-white rounded-xl max-w-2xl mt-8 flex items-center gap-4 px-5 py-4">
                    <span class="text-3xl text-gray-400">⌕</span>
                    <input type="text"
                        placeholder="Service search karein jaise Aadhaar, PAN, Niwas..."
                        class="w-full outline-none text-gray-700 text-base md:text-lg">
                </div>

                <div class="flex flex-wrap gap-4 mt-8">

                    <a href="#services"
                        class="btn-primary px-9 py-4 rounded-xl font-black text-lg">
                        Apply Now
                    </a>

                    <a href="/status-check"
                        class="btn-outline px-9 py-4 rounded-xl font-black text-lg">
                        Check Status
                    </a>

                </div>

            </div>

            <div class="hidden lg:flex justify-center fade-up">

                <div class="relative float-soft">

                    <div class="w-[430px] h-[300px] bg-cyan-400/20 rounded-[40px] absolute -z-10 blur-3xl"></div>

                    <div class="bg-white/10 border border-white/20 backdrop-blur-xl rounded-[32px] p-8 w-[440px]">
                        <div class="bg-white rounded-3xl p-8 shadow-2xl">

                            <div class="flex justify-center gap-6 mb-6">
                                <div class="w-20 h-20 rounded-2xl bg-blue-50 flex items-center justify-center text-4xl shadow">🪪</div>
                                <div class="w-20 h-20 rounded-2xl bg-cyan-50 flex items-center justify-center text-4xl shadow">📄</div>
                                <div class="w-20 h-20 rounded-2xl bg-green-50 flex items-center justify-center text-4xl shadow">💳</div>
                            </div>

                            <div class="flex items-center gap-5 mt-8">
                                <div class="w-32 h-32 rounded-full bg-cyan-100 flex items-center justify-center text-7xl">
                                    👩‍💻
                                </div>
                                <div>
                                    <h3 class="text-2xl font-black text-[#09245f]">Digital Help Desk</h3>
                                    <p class="text-gray-500 mt-2">Fast support for online services</p>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>

            </div>

        </section>

        <div class="grid lg:grid-cols-[1fr_430px] gap-10 px-5 md:px-16 py-10 md:py-14">

            <!-- LEFT MAIN -->

            <main>

                <!-- POPULAR SERVICES -->

                <section id="services">

                    <h2 class="text-3xl font-black text-black mb-8">
                        Popular Services
                    </h2>

                    <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-6">

                        <div class="service-card rounded-2xl p-6">
                            <div class="icon-circle w-16 h-16 rounded-full flex items-center justify-center text-4xl">🪪</div>
                            <h3 class="text-lg font-black mt-5">Aadhaar Address Change</h3>
                            <p class="text-gray-600 text-sm mt-2 leading-6">
                                Clean services and Aadhaar address change.
                            </p>
                            <a href="/aadhar-update" class="inline-block mt-5 px-7 py-3 rounded-lg bg-[#0d6dcc] text-white font-bold hover:bg-[#09245f] transition">
                                Apply
                            </a>
                        </div>

                        <div class="service-card rounded-2xl p-6">
                            <div class="icon-circle w-16 h-16 rounded-full flex items-center justify-center text-4xl">💳</div>
                            <h3 class="text-lg font-black mt-5">New PAN Card</h3>
                            <p class="text-gray-600 text-sm mt-2 leading-6">
                                Aadhaar, PAN, certificate and card digital services.
                            </p>
                            <a href="/new-pan" class="inline-block mt-5 px-7 py-3 rounded-lg bg-[#0d6dcc] text-white font-bold hover:bg-[#09245f] transition">
                                Apply
                            </a>
                        </div>

                        <div class="service-card rounded-2xl p-6">
                            <div class="icon-circle w-16 h-16 rounded-full flex items-center justify-center text-4xl">📄</div>
                            <h3 class="text-lg font-black mt-5">PAN Correction</h3>
                            <p class="text-gray-600 text-sm mt-2 leading-6">
                                Clean correction service for PAN card details.
                            </p>
                            <a href="/pan-correction" class="inline-block mt-5 px-7 py-3 rounded-lg bg-[#0d6dcc] text-white font-bold hover:bg-[#09245f] transition">
                                Apply
                            </a>
                        </div>

                        <div class="service-card rounded-2xl p-6">
                            <div class="icon-circle w-16 h-16 rounded-full flex items-center justify-center text-4xl">🏠</div>
                            <h3 class="text-lg font-black mt-5">Niwas Praman Patra</h3>
                            <p class="text-gray-600 text-sm mt-2 leading-6">
                                Residence certificate online service support.
                            </p>
                            <a href="/contact" class="inline-block mt-5 px-7 py-3 rounded-lg bg-[#0d6dcc] text-white font-bold hover:bg-[#09245f] transition">
                                Apply
                            </a>
                        </div>

                        <div class="service-card rounded-2xl p-6">
                            <div class="icon-circle w-16 h-16 rounded-full flex items-center justify-center text-4xl">📋</div>
                            <h3 class="text-lg font-black mt-5">Jati Praman Patra</h3>
                            <p class="text-gray-600 text-sm mt-2 leading-6">
                                Caste certificate service support.
                            </p>
                            <a href="/contact" class="inline-block mt-5 px-7 py-3 rounded-lg bg-[#0d6dcc] text-white font-bold hover:bg-[#09245f] transition">
                                Apply
                            </a>
                        </div>

                        <div class="service-card rounded-2xl p-6">
                            <div class="icon-circle w-16 h-16 rounded-full flex items-center justify-center text-4xl">💰</div>
                            <h3 class="text-lg font-black mt-5">Aay Praman Patra</h3>
                            <p class="text-gray-600 text-sm mt-2 leading-6">
                                Income certificate application support.
                            </p>
                            <a href="/contact" class="inline-block mt-5 px-7 py-3 rounded-lg bg-[#0d6dcc] text-white font-bold hover:bg-[#09245f] transition">
                                Apply
                            </a>
                        </div>

                        <div class="service-card rounded-2xl p-6">
                            <div class="icon-circle w-16 h-16 rounded-full flex items-center justify-center text-4xl">🧾</div>
                            <h3 class="text-lg font-black mt-5">E-Shram Card</h3>
                            <p class="text-gray-600 text-sm mt-2 leading-6">
                                E-Shram card online registration support.
                            </p>
                            <a href="/contact" class="inline-block mt-5 px-7 py-3 rounded-lg bg-[#0d6dcc] text-white font-bold hover:bg-[#09245f] transition">
                                Apply
                            </a>
                        </div>

                        <div class="service-card rounded-2xl p-6">
                            <div class="icon-circle w-16 h-16 rounded-full flex items-center justify-center text-4xl">🪪</div>
                            <h3 class="text-lg font-black mt-5">Ration Card</h3>
                            <p class="text-gray-600 text-sm mt-2 leading-6">
                                Ration card and digital service help.
                            </p>
                            <a href="/contact" class="inline-block mt-5 px-7 py-3 rounded-lg bg-[#0d6dcc] text-white font-bold hover:bg-[#09245f] transition">
                                Apply
                            </a>
                        </div>

                    </div>

                </section>

            </main>

            <!-- RIGHT SIDEBAR -->

            <aside class="space-y-10">

                <!-- STATUS CHECK -->

                <section>

                    <h2 class="text-2xl font-black mb-5">
                        Status Check Section
                    </h2>

                    <div class="right-card rounded-2xl p-6 max-w-sm mx-auto">

                        <h3 class="text-xl font-black text-center mb-5">
                            Application Status Check
                        </h3>

                        <form action="/status-check" method="GET" class="space-y-3">
                            <input type="text"
                                name="token"
                                placeholder="Token / Application ID"
                                class="w-full border rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-[#0d6dcc]">

                            <button type="submit"
                                class="w-full rounded-lg bg-[#0d6dcc] text-white font-bold py-3 hover:bg-[#09245f] transition">
                                Check Now
                            </button>
                        </form>

                    </div>

                </section>

                <!-- IMPORTANT LINKS -->

                <section id="links">

                    <h2 class="text-2xl font-black mb-5">
                        Bihar Important Links Section
                    </h2>

                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">

                        <% if (settings && settings.importantLinks && settings.importantLinks.length > 0) { %>

                            <% settings.importantLinks.forEach((link) => { %>

                                <a href="<%= link.url %>" target="_blank"
                                    class="mini-link rounded-xl p-4 text-center">
                                    <div class="text-4xl">🌐</div>
                                    <p class="text-xs font-black mt-3"><%= link.title %></p>
                                </a>

                            <% }) %>

                        <% } else { %>

                            <a href="https://uidai.gov.in" target="_blank" class="mini-link rounded-xl p-4 text-center">
                                <div class="text-4xl">🪪</div>
                                <p class="text-xs font-black mt-3">UIDAI</p>
                            </a>

                            <a href="https://www.onlineservices.nsdl.com" target="_blank" class="mini-link rounded-xl p-4 text-center">
                                <div class="text-4xl">💳</div>
                                <p class="text-xs font-black mt-3">NSDL PAN</p>
                            </a>

                            <a href="https://serviceonline.bihar.gov.in" target="_blank" class="mini-link rounded-xl p-4 text-center">
                                <div class="text-4xl">🏛️</div>
                                <p class="text-xs font-black mt-3">Bihar RTPS</p>
                            </a>

                            <a href="https://voters.eci.gov.in" target="_blank" class="mini-link rounded-xl p-4 text-center">
                                <div class="text-4xl">🗳️</div>
                                <p class="text-xs font-black mt-3">Voter Portal</p>
                            </a>

                            <a href="/contact" class="mini-link rounded-xl p-4 text-center">
                                <div class="text-4xl">📄</div>
                                <p class="text-xs font-black mt-3">District Bihar</p>
                            </a>

                            <a href="/contact" class="mini-link rounded-xl p-4 text-center">
                                <div class="text-4xl">🧾</div>
                                <p class="text-xs font-black mt-3">Ration Card</p>
                            </a>

                        <% } %>

                    </div>

                </section>

                <!-- FORM PREVIEW -->

                <section>

                    <div class="right-card rounded-2xl p-5 max-w-sm mx-auto">

                        <div class="space-y-3">
                            <input class="w-full border rounded-lg px-4 py-3 text-sm" placeholder="Name" disabled>
                            <input class="w-full border rounded-lg px-4 py-3 text-sm" placeholder="Mobile Number" disabled>
                            <select class="w-full border rounded-lg px-4 py-3 text-sm" disabled>
                                <option>Select Service</option>
                            </select>

                            <div class="grid grid-cols-2 gap-3">
                                <button class="border border-dashed rounded-lg py-3 text-sm font-semibold" disabled>
                                    ⇧ Upload Document
                                </button>

                                <div class="bg-gray-100 rounded-lg p-3 text-center text-xs font-bold">
                                    Payment QR
                                    <div class="text-3xl mt-2">▦</div>
                                </div>
                            </div>

                            <div class="h-8 bg-gray-300 rounded-lg"></div>

                            <p class="text-xs font-semibold text-center">
                                Details → Upload → Payment → Success
                            </p>
                        </div>

                    </div>

                </section>

                <!-- CONTACT -->

                <section id="contact">

                    <h2 class="text-2xl font-black mb-5">
                        Contact
                    </h2>

                    <div class="right-card rounded-2xl overflow-hidden">

                        <div class="grid grid-cols-2">

                            <div class="bg-blue-50 flex items-center justify-center text-center p-4">
                                <div>
                                    <div class="text-6xl">📍</div>
                                    <p class="text-xs mt-3 font-semibold">Google Map Area</p>
                                </div>
                            </div>

                            <div class="p-5">

                                <h3 class="font-black text-lg">
                                    <%= settings && settings.shopName ? settings.shopName : "Cyber Point" %> - Digital Seva Kendra
                                </h3>

                                <p class="text-gray-600 text-sm mt-2">
                                    <%= settings && settings.shopAddress ? settings.shopAddress : "Cyber Point - Digital Seva Kendra" %>
                                </p>

                                <div class="space-y-3 mt-5">

                                    <a href="tel:<%= settings && settings.paymentNumber ? settings.paymentNumber : '' %>"
                                        class="block text-center bg-[#0d6dcc] text-white rounded-lg py-3 font-bold">
                                        Call
                                    </a>

                                    <a href="https://wa.me/<%= settings && settings.whatsappNumber ? settings.whatsappNumber : '' %>"
                                        target="_blank"
                                        class="block text-center bg-green-500 text-white rounded-lg py-3 font-bold">
                                        WhatsApp
                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                </section>

            </aside>

        </div>

        <!-- FOOTER -->

        <footer class="px-5 md:px-16 py-5 border-t text-sm text-gray-600 flex flex-col md:flex-row items-center justify-between gap-3">
            <p>Copyright © Cyber Point</p>
            <p>Owner: KAISH</p>
        </footer>

    </div>

    <!-- MOBILE BOTTOM BAR -->

    <div class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t shadow-2xl md:hidden">

        <div class="grid grid-cols-4 text-center text-xs font-black">

            <a href="/" class="py-3 text-[#09245f]">
                🏠<br>Home
            </a>

            <a href="/services" class="py-3 text-[#09245f]">
                🧾<br>Services
            </a>

            <a href="/status-check" class="py-3 text-[#09245f]">
                🔎<br>Status
            </a>

            <a href="/contact" class="py-3 text-green-600">
                💬<br>Contact
            </a>

        </div>

    </div>

</body>

</html>