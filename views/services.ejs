<!DOCTYPE html>
<html lang="en">
<head>
    <title>CyberPoint Services</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        * { font-family: Poppins, sans-serif; }
        body { background:#eef6ff; color:#111827; }
        html { scroll-behavior:smooth; }

        .page-shell {
            max-width:1500px;
            margin:42px auto;
            background:white;
            border-radius:28px;
            overflow:hidden;
            box-shadow:0 25px 80px rgba(15,23,42,.18);
        }

        .hero {
            background:linear-gradient(120deg,#06175f,#0a3f91,#087fd1);
        }

        .service-card {
            position:relative;
            background:white;
            border:1px solid #e5edf7;
            box-shadow:0 14px 34px rgba(15,23,42,.14);
            transition:.28s ease;
            overflow:hidden;
        }

        .service-card:hover {
            transform:translateY(-8px);
            box-shadow:0 24px 50px rgba(15,23,42,.20);
        }

        .price-tag {
            position:absolute;
            top:0;
            right:0;
            background:#ff8a24;
            color:white;
            padding:8px 12px;
            border-bottom-left-radius:18px;
            font-size:13px;
            font-weight:600;
        }

        .price-tag strong { font-size:22px; }
        .icon-circle { background:#dff6ff; }

        .right-card {
            background:white;
            box-shadow:0 18px 45px rgba(15,23,42,.14);
            border:1px solid #e8eef7;
        }

        .process-card {
            min-height:150px;
            position:relative;
        }

        .process-number {
            position:absolute;
            right:18px;
            top:14px;
            color:#c5c9cf;
            font-size:34px;
            font-weight:900;
        }

        .why-card {
            background:white;
            border:1px solid #e8eef7;
            box-shadow:0 12px 28px rgba(15,23,42,.10);
        }

        .bottom-cta {
            background:linear-gradient(120deg,#06175f,#08c6d8);
        }
    </style>
</head>

<body>

<div class="page-shell">

    <header class="bg-white px-5 md:px-16 py-6 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
            <h1 class="text-2xl md:text-3xl font-black text-[#09245f]">
                <%= settings && settings.shopName ? settings.shopName : "CYBER POINT" %>
            </h1>
            <span class="w-3 h-3 bg-cyan-400 rounded-full"></span>
        </a>

        <nav class="hidden lg:flex items-center gap-8 font-semibold">
            <a href="/">Home</a>
            <a href="/services" class="text-[#0d6dcc] border-b-2 border-[#0d6dcc]">Services</a>
            <a href="/status-check">Status Check</a>
            <a href="/#contact">Contact</a>
            <a href="/admin/login">Admin Login</a>
        </nav>

        <a href="https://wa.me/<%= settings && settings.whatsappNumber ? settings.whatsappNumber : '' %>"
           target="_blank"
           class="hidden md:inline-flex px-6 py-3 rounded-lg bg-orange-500 text-white font-bold">
            WhatsApp/Call ☎
        </a>
    </header>

    <section class="hero px-5 md:px-16 pt-16 md:pt-24 pb-24 md:pb-32">
        <h2 class="text-4xl md:text-6xl font-black text-white">
            हमारी ऑनलाइन सेवाएं
        </h2>

        <p class="text-white/90 text-lg md:text-xl mt-5">
            Aadhaar, PAN, Certificate, Ration Card और सभी Digital Services एक जगह
        </p>

        <div class="bg-white rounded-xl max-w-4xl mt-8 flex items-center gap-4 px-5 py-4 shadow-xl">
            <span class="text-3xl text-gray-400">⌕</span>
            <input type="text" placeholder="Service search karein..." class="w-full outline-none text-gray-700 text-base md:text-lg">
        </div>

        <div class="flex flex-wrap gap-3 mt-7">
            <span class="bg-white text-[#06175f] rounded-full px-6 py-2 font-semibold">All</span>
            <span class="border border-white/50 text-white rounded-full px-6 py-2">Aadhaar</span>
            <span class="border border-white/50 text-white rounded-full px-6 py-2">PAN</span>
            <span class="border border-white/50 text-white rounded-full px-6 py-2">Certificates</span>
            <span class="border border-white/50 text-white rounded-full px-6 py-2">Cards</span>
            <span class="border border-white/50 text-white rounded-full px-6 py-2">Other Services</span>
        </div>
    </section>

    <div class="grid lg:grid-cols-[1fr_430px] gap-10 px-5 md:px-16 pb-10 md:pb-14">

        <main>
            <section class="-mt-16">
                <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-6">

                    <% const services = [
                        ["🪪","Aadhaar Address Change","Clean clear services and Aadhaar Address Change.","/aadhar-update"],
                        ["💳","New PAN Card","Aadhaar, PAN, Certificate, Ration Card और Digital Services.","/new-pan"],
                        ["📄","PAN Correction","Clean correction service for PAN card details.","/pan-correction"],
                        ["🏠","Niwas Praman Patra","Residence certificate online service support.","/#contact"],
                        ["📋","Jati Praman Patra","Caste certificate service support.","/#contact"],
                        ["💰","Aay Praman Patra","Income certificate online application support.","/#contact"],
                        ["🧾","E-Shram Card","E-Shram card online registration support.","/#contact"],
                        ["🪪","Ration Card","Ration card and digital service help.","/#contact"],
                        ["🗳️","Voter ID","Voter ID apply and correction support.","/#contact"],
                        ["👶","Birth Certificate","Birth certificate online application support.","/#contact"],
                        ["⚡","Electricity Bill","Electricity bill payment support.","/#contact"],
                        ["📝","Online Form Fillup","Online form fillup and exam form support.","/#contact"]
                    ]; %>

                    <% services.forEach(service => { %>
                        <div class="service-card rounded-2xl p-6">
                            <div class="price-tag">Starting ₹<strong>99</strong></div>

                            <div class="icon-circle w-16 h-16 rounded-full flex items-center justify-center text-4xl">
                                <%= service[0] %>
                            </div>

                            <h3 class="text-lg font-black mt-5">
                                <%= service[1] %>
                            </h3>

                            <p class="text-gray-600 text-sm mt-2 leading-6">
                                <%= service[2] %>
                            </p>

                            <a href="<%= service[3] %>"
                               class="inline-block mt-5 px-7 py-3 rounded-lg bg-[#0d6dcc] text-white font-bold hover:bg-[#09245f] transition">
                                Apply Now
                            </a>
                        </div>
                    <% }) %>

                </div>
            </section>
        </main>

        <aside class="space-y-12">

            <section>
                <h2 class="text-3xl font-black">Service Process Section</h2>
                <p class="text-xl mt-1">Service Apply करने का आसान तरीका</p>

                <div class="grid grid-cols-2 gap-5 mt-6">
                    <div class="right-card process-card rounded-2xl p-6">
                        <span class="process-number">1.</span>
                        <div class="w-14 h-14 rounded-full bg-cyan-100 flex items-center justify-center text-3xl">📋</div>
                        <h3 class="font-black text-xl mt-5">Details Fill करें</h3>
                    </div>

                    <div class="right-card process-card rounded-2xl p-6">
                        <span class="process-number">2.</span>
                        <div class="w-14 h-14 rounded-full bg-cyan-100 flex items-center justify-center text-3xl">📄</div>
                        <h3 class="font-black text-xl mt-5">Documents Upload करें</h3>
                    </div>

                    <div class="right-card process-card rounded-2xl p-6">
                        <span class="process-number">3.</span>
                        <div class="w-14 h-14 rounded-full bg-cyan-100 flex items-center justify-center text-3xl">💳</div>
                        <h3 class="font-black text-xl mt-5">Payment करें</h3>
                    </div>

                    <div class="right-card process-card rounded-2xl p-6">
                        <span class="process-number">4.</span>
                        <div class="w-14 h-14 rounded-full bg-cyan-100 flex items-center justify-center text-3xl">🧾</div>
                        <h3 class="font-black text-xl mt-5">Receipt Download करें</h3>
                    </div>
                </div>
            </section>

            <section>
                <h2 class="text-3xl font-black">Why Choose Cyber Point” Section</h2>

                <div class="grid grid-cols-4 gap-4 mt-6">
                    <div class="why-card rounded-xl p-4 text-center">
                        <div class="text-4xl">⏱️</div>
                        <h3 class="font-black text-sm mt-3">Fast Service</h3>
                    </div>
                    <div class="why-card rounded-xl p-4 text-center">
                        <div class="text-4xl">📄</div>
                        <h3 class="font-black text-sm mt-3">Secure Documents</h3>
                    </div>
                    <div class="why-card rounded-xl p-4 text-center">
                        <div class="text-4xl">🔍</div>
                        <h3 class="font-black text-sm mt-3">Status Tracking</h3>
                    </div>
                    <div class="why-card rounded-xl p-4 text-center">
                        <div class="text-4xl">🎧</div>
                        <h3 class="font-black text-sm mt-3">Local Support</h3>
                    </div>
                </div>
            </section>

            <section>
                <h2 class="text-3xl font-black">Bottom CTA Section</h2>

                <div class="bottom-cta rounded-2xl p-8 text-center text-white mt-5">
                    <h3 class="text-3xl font-black">कौन सी सेवा चाहिए?</h3>
                    <p class="mt-3 text-white/85">Search करें या सीधे Apply Now पर क्लिक करें</p>

                    <div class="flex justify-center gap-4 mt-6">
                        <a href="#top" class="px-8 py-3 rounded-lg bg-cyan-400 text-white font-bold">Apply Now</a>
                        <a href="/status-check" class="px-8 py-3 rounded-lg border border-cyan-300 text-cyan-100 font-bold">Check Status</a>
                    </div>
                </div>
            </section>

        </aside>
    </div>

    <footer class="px-5 md:px-16 py-5 border-t text-sm text-gray-600 flex flex-col md:flex-row items-center justify-between gap-3">
        <p>Copyright © Cyber Point</p>
        <p>Owner: KAISH</p>
    </footer>

</div>

</body>
</html>