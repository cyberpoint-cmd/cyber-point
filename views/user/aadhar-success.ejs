<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Application Submitted</title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="bg-[#050816] text-white flex items-center justify-center min-h-screen px-4">

    <div class="max-w-2xl w-full bg-[#0b1120] border border-cyan-500 rounded-3xl p-10 text-center">

        <div class="w-28 h-28 mx-auto rounded-full bg-cyan-500 flex items-center justify-center text-6xl">

            ✓

        </div>

        <h1 class="text-5xl font-bold text-cyan-400 mt-10">

            Application Submitted

        </h1>

        <p class="text-gray-300 mt-6 text-lg">

            Please wait for receiving upload.

        </p>

        <div class="mt-10 bg-black border border-cyan-400 rounded-3xl p-8">

            <p class="text-gray-400 text-lg">

                Your Token Number

            </p>

            <h2 class="text-5xl font-bold text-cyan-400 mt-4">

                <%= token %>

            </h2>

        </div>

        <a href="/"
            class="inline-block mt-10 px-10 py-4 bg-cyan-500 rounded-2xl text-black font-bold hover:bg-cyan-600 transition">

            Back Home

        </a>

    </div>

</body>
</html>