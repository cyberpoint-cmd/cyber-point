<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Status Check</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#050816] text-white">

    <%- include("../partials/navbar") %>

    <div class="min-h-screen py-10 px-4">

        <div class="max-w-4xl mx-auto">

            <div class="bg-[#0b1120] border border-cyan-500 rounded-3xl p-6 md:p-10">

                <div class="text-center">

                    <h1 class="text-4xl font-bold text-cyan-400">
                        Application Status Check
                    </h1>

                    <p class="mt-4 text-gray-300">
                        <%= settings.shopName || "CyberPoint" %>
                    </p>

                    <p class="mt-2 text-gray-400">
                        Token Number enter karke status dekhiye
                    </p>

                </div>

                <!-- FORM -->

                <form action="/status-check" method="POST" class="mt-10">

                    <div class="flex flex-col md:flex-row gap-4">

                        <input
                            type="text"
                            name="tokenNumber"
                            placeholder="Enter Token Number"
                            required
                            class="flex-1 px-5 py-4 rounded-2xl bg-black border border-cyan-400 outline-none">

                        <button
                            type="submit"
                            class="px-8 py-4 bg-cyan-500 rounded-2xl text-black font-bold hover:bg-cyan-600">

                            Check Status

                        </button>

                    </div>

                </form>

                <!-- RESULT -->

                <% if (application) { %>

                    <div class="mt-10 bg-black border border-cyan-500 rounded-3xl p-6">

                        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-5">

                            <div>

                                <h2 class="text-3xl font-bold text-cyan-400">
                                    Application Found
                                </h2>

                                <p class="text-gray-400 mt-2">
                                    Token: <%= application.tokenNumber %>
                                </p>

                            </div>

                            <span class="px-5 py-3 rounded-2xl font-bold
                                <%= application.status === 'Completed'
                                    ? 'bg-green-500/20 text-green-400'
                                    : application.status === 'Rejected'
                                    ? 'bg-red-500/20 text-red-400'
                                    : application.status === 'Processing'
                                    ? 'bg-blue-500/20 text-blue-400'
                                    : application.status === 'OTP Pending'
                                    ? 'bg-purple-500/20 text-purple-400'
                                    : 'bg-yellow-500/20 text-yellow-400' %>">

                                <%= application.status %>

                            </span>

                        </div>

                        <div class="grid md:grid-cols-2 gap-6 mt-8">

                            <div class="bg-[#0b1120] border border-cyan-500 rounded-2xl p-5">

                                <p class="text-gray-400">
                                    Applicant Name
                                </p>

                                <h3 class="text-xl font-bold mt-2">
                                    <%= application.applicantName || "-" %>
                                </h3>

                            </div>

                            <div class="bg-[#0b1120] border border-cyan-500 rounded-2xl p-5">

                                <p class="text-gray-400">
                                    Mobile Number
                                </p>

                                <h3 class="text-xl font-bold mt-2">
                                    <%= application.phoneNumber || "-" %>
                                </h3>

                            </div>

                            <div class="bg-[#0b1120] border border-cyan-500 rounded-2xl p-5">

                                <p class="text-gray-400">
                                    Service
                                </p>

                                <h3 class="text-xl font-bold mt-2">
                                    <%= application.serviceType || "-" %>
                                </h3>

                            </div>

                            <div class="bg-[#0b1120] border border-cyan-500 rounded-2xl p-5">

                                <p class="text-gray-400">
                                    Amount
                                </p>

                                <h3 class="text-xl font-bold text-green-400 mt-2">
                                    ₹<%= application.amount || 0 %>
                                </h3>

                            </div>

                            <div class="bg-[#0b1120] border border-cyan-500 rounded-2xl p-5">

                                <p class="text-gray-400">
                                    UTR Number
                                </p>

                                <h3 class="text-xl font-bold mt-2">
                                    <%= application.utrNumber || "Not Submitted Yet" %>
                                </h3>

                            </div>

                            <div class="bg-[#0b1120] border border-cyan-500 rounded-2xl p-5">

                                <p class="text-gray-400">
                                    Date
                                </p>

                                <h3 class="text-lg font-bold mt-2">
                                    <% if (application.createdAt) { %>
                                        <%= new Date(application.createdAt).toLocaleString() %>
                                    <% } else { %>
                                        -
                                    <% } %>
                                </h3>

                            </div>

                        </div>

                        <!-- ACTION BUTTONS -->

                        <div class="grid md:grid-cols-3 gap-5 mt-10">

                            <a href="/receipt/<%= application.tokenNumber %>"
                                class="text-center py-4 bg-cyan-500 rounded-2xl text-black font-bold hover:bg-cyan-600 transition">

                                View Receipt

                            </a>

                            <% if (application.receivingPdf) { %>

                                <a href="<%= application.receivingPdf %>"
                                    target="_blank"
                                    class="text-center py-4 bg-green-500 rounded-2xl text-black font-bold hover:bg-green-600 transition">

                                    Download Receiving

                                </a>

                            <% } else { %>

                                <div class="text-center py-4 border border-gray-600 rounded-2xl text-gray-400">
                                    Receiving Pending
                                </div>

                            <% } %>

                            <a href="https://wa.me/<%= settings.whatsappNumber || '' %>"
                                target="_blank"
                                class="text-center py-4 border border-green-500 rounded-2xl text-green-400 hover:bg-green-500 hover:text-black transition">

                                WhatsApp Support

                            </a>

                        </div>

                    </div>

                <% } else if (application === undefined) { %>

                    <div class="mt-10 bg-red-500/10 border border-red-500 rounded-3xl p-6 text-center">

                        <h2 class="text-2xl font-bold text-red-400">
                            Invalid Token Number
                        </h2>

                        <p class="text-gray-400 mt-3">
                            Token check karke dobara try karein.
                        </p>

                    </div>

                <% } %>

                <!-- SUPPORT BOX -->

                <div class="mt-10 bg-black border border-cyan-500 rounded-3xl p-6 text-center">

                    <h3 class="text-2xl font-bold text-cyan-400">
                        Need Help?
                    </h3>

                    <p class="text-gray-400 mt-3">
                        WhatsApp:
                        <span class="text-cyan-400 font-bold">
                            <%= settings.whatsappNumber || "-" %>
                        </span>
                    </p>

                    <p class="text-gray-400 mt-2">
                        <%= settings.noticeText || "Please keep your token number safe." %>
                    </p>

                </div>

            </div>

        </div>

    </div>

    <%- include("../partials/footer") %>

</body>
</html>