<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Change Password</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#050816] text-white">

    <div class="max-w-3xl mx-auto p-6">

        <div class="flex items-center justify-between">

            <div>

                <h1 class="text-4xl font-bold text-cyan-400">
                    Change Password
                </h1>

                <p class="text-gray-400 mt-3">
                    Update admin account password
                </p>

            </div>

            <a href="/admin/dashboard"
                class="px-6 py-3 bg-cyan-500 rounded-2xl text-black font-bold">

                Dashboard

            </a>

        </div>

        <% if (success) { %>

            <div class="bg-green-500/20 border border-green-500 text-green-400 rounded-2xl p-5 mt-8">

                <%= success %>

            </div>

        <% } %>

        <% if (error) { %>

            <div class="bg-red-500/20 border border-red-500 text-red-400 rounded-2xl p-5 mt-8">

                <%= error %>

            </div>

        <% } %>

        <div class="bg-[#0b1120] border border-cyan-500 rounded-3xl p-8 mt-10">

            <form
                action="/admin/change-password"
                method="POST"
                class="space-y-6">

                <div>

                    <label class="block mb-3 text-cyan-400 font-bold">
                        Current Password
                    </label>

                    <input
                        type="password"
                        name="currentPassword"
                        required
                        class="w-full px-5 py-4 rounded-2xl bg-black border border-cyan-400 outline-none">

                </div>

                <div>

                    <label class="block mb-3 text-cyan-400 font-bold">
                        New Password
                    </label>

                    <input
                        type="password"
                        name="newPassword"
                        required
                        class="w-full px-5 py-4 rounded-2xl bg-black border border-cyan-400 outline-none">

                </div>

                <div>

                    <label class="block mb-3 text-cyan-400 font-bold">
                        Confirm Password
                    </label>

                    <input
                        type="password"
                        name="confirmPassword"
                        required
                        class="w-full px-5 py-4 rounded-2xl bg-black border border-cyan-400 outline-none">

                </div>

                <button
                    type="submit"
                    class="w-full py-4 bg-cyan-500 rounded-2xl text-black font-bold hover:bg-cyan-600 transition">

                    Update Password

                </button>

            </form>

        </div>

    </div>

</body>

</html>