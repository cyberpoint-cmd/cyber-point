<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Upload Receiving</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#050816] text-white">

    <div class="flex min-h-screen">

        <!-- SIDEBAR -->

        <aside class="w-72 bg-black border-r border-cyan-500 p-6 hidden md:block">

            <h1 class="text-4xl font-bold text-cyan-400">
                CyberPoint
            </h1>

            <p class="text-gray-400 mt-2">
                Admin Panel
            </p>

            <div class="mt-12 space-y-4">

                <a href="/admin/dashboard"
                    class="block px-5 py-4 rounded-2xl border border-cyan-500 hover:bg-cyan-500 hover:text-black transition">
                    Dashboard
                </a>

                <a href="/admin/otp-requests"
                    class="block px-5 py-4 rounded-2xl border border-cyan-500 hover:bg-cyan-500 hover:text-black transition">
                    Live OTP Requests
                </a>

                <a href="/admin/aadhar-applications"
                    class="block px-5 py-4 rounded-2xl border border-cyan-500 hover:bg-cyan-500 hover:text-black transition">
                    Aadhar Applications
                </a>

                <a href="/admin/pan-applications"
                    class="block px-5 py-4 rounded-2xl border border-cyan-500 hover:bg-cyan-500 hover:text-black transition">
                    PAN Applications
                </a>

                <a href="/admin/upload-receiving"
                    class="block px-5 py-4 rounded-2xl bg-cyan-500 text-black font-bold">
                    Upload Receiving
                </a>

                <a href="/admin/backup"
                    class="block px-5 py-4 rounded-2xl border border-cyan-500 hover:bg-cyan-500 hover:text-black transition">
                    Backup & Export
                </a>

                <a href="/admin/settings"
                    class="block px-5 py-4 rounded-2xl border border-cyan-500 hover:bg-cyan-500 hover:text-black transition">
                    Settings
                </a>

                <a href="/admin/logout"
                    class="block px-5 py-4 rounded-2xl border border-red-500 text-red-400 hover:bg-red-500 hover:text-white transition">
                    Logout
                </a>

            </div>

        </aside>

        <!-- MAIN -->

        <main class="flex-1 p-6 md:p-10">

            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">

                <div>

                    <h2 class="text-4xl font-bold text-cyan-400">
                        Upload Receiving
                    </h2>

                    <p class="text-gray-400 mt-3">
                        Customer token ke hisab se receiving PDF upload karein
                    </p>

                </div>

                <a href="/admin/dashboard"
                    class="px-6 py-3 bg-cyan-500 rounded-xl text-black font-bold text-center">
                    Back Dashboard
                </a>

            </div>

            <!-- FORM BOX -->

            <div class="max-w-3xl bg-[#0b1120] border border-cyan-500 rounded-3xl p-8 mt-10">

                <form
                    action="/admin/upload-receiving"
                    method="POST"
                    enctype="multipart/form-data"
                    class="space-y-6">

                    <div>

                        <label class="block mb-2 text-gray-300">
                            Token Number
                        </label>

                        <input
                            type="text"
                            name="tokenNumber"
                            required
                            placeholder="Example: CYBERCAFE01"
                            class="w-full px-5 py-4 rounded-2xl bg-black border border-cyan-400 outline-none">

                    </div>

                    <div>

                        <label class="block mb-2 text-gray-300">
                            Application Status
                        </label>

                        <select
                            name="status"
                            required
                            class="w-full px-5 py-4 rounded-2xl bg-black border border-cyan-400 outline-none">

                            <option value="Pending">Pending</option>
                            <option value="Processing">Processing</option>
                            <option value="Completed">Completed</option>
                            <option value="Rejected">Rejected</option>

                        </select>

                    </div>

                    <div>

                        <label class="block mb-2 text-gray-300">
                            Upload Receiving PDF
                        </label>

                        <input
                            type="file"
                            name="receivingPdf"
                            accept="application/pdf"
                            required
                            class="w-full bg-black border border-cyan-400 rounded-2xl p-4">

                    </div>

                    <button
                        type="submit"
                        class="w-full py-4 bg-cyan-500 rounded-2xl text-black font-bold hover:bg-cyan-600 transition">

                        Upload Receiving

                    </button>

                </form>

            </div>

            <!-- GUIDE -->

            <div class="max-w-3xl bg-black border border-yellow-500 rounded-3xl p-8 mt-10">

                <h3 class="text-2xl font-bold text-yellow-400">
                    Important Guide
                </h3>

                <div class="mt-5 space-y-3 text-gray-300">

                    <p>✅ Token number customer receipt/status se copy karein.</p>
                    <p>✅ Sirf PDF file upload karein.</p>
                    <p>✅ Completed status select karne ke baad customer status page se PDF download kar sakta hai.</p>
                    <p>✅ Galat token dalne par system "Invalid Token" dikhayega.</p>

                </div>

            </div>

        </main>

    </div>

</body>
</html>