<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>PAN Applications</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#050816] text-white">

    <div class="flex min-h-screen">

        <!-- SIDEBAR -->

        <aside class="w-72 bg-black border-r border-cyan-500 p-6 hidden md:block">

            <h1 class="text-4xl font-bold text-cyan-400">
                CyberPoint
            </h1>

            <p class="text-gray-400 mt-2">
                Admin Panel
            </p>

            <div class="mt-12 space-y-4">

                <a href="/admin/dashboard"
                    class="block px-5 py-4 rounded-2xl border border-cyan-500 hover:bg-cyan-500 hover:text-black transition">
                    Dashboard
                </a>

                <a href="/admin/otp-requests"
                    class="block px-5 py-4 rounded-2xl border border-cyan-500 hover:bg-cyan-500 hover:text-black transition">
                    Live OTP Requests
                </a>

                <a href="/admin/aadhar-applications"
                    class="block px-5 py-4 rounded-2xl border border-cyan-500 hover:bg-cyan-500 hover:text-black transition">
                    Aadhar Applications
                </a>

                <a href="/admin/pan-applications"
                    class="block px-5 py-4 rounded-2xl bg-cyan-500 text-black font-bold">
                    PAN Applications
                </a>

                <a href="/admin/upload-receiving"
                    class="block px-5 py-4 rounded-2xl border border-cyan-500 hover:bg-cyan-500 hover:text-black transition">
                    Upload Receiving
                </a>

                <a href="/admin/backup"
                    class="block px-5 py-4 rounded-2xl border border-cyan-500 hover:bg-cyan-500 hover:text-black transition">
                    Backup & Export
                </a>

                <a href="/admin/settings"
                    class="block px-5 py-4 rounded-2xl border border-cyan-500 hover:bg-cyan-500 hover:text-black transition">
                    Settings
                </a>

                <a href="/admin/logout"
                    class="block px-5 py-4 rounded-2xl border border-red-500 text-red-400 hover:bg-red-500 hover:text-white transition">
                    Logout
                </a>

            </div>

        </aside>

        <!-- MAIN -->

        <main class="flex-1 p-6 md:p-10">

            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">

                <div>

                    <h2 class="text-4xl font-bold text-cyan-400">
                        PAN Applications
                    </h2>

                    <p class="text-gray-400 mt-2">
                        Search aur filter ke sath real submitted PAN applications
                    </p>

                </div>

                <a href="/admin/dashboard"
                    class="px-6 py-3 bg-cyan-500 rounded-xl text-black font-bold text-center">
                    Back Dashboard
                </a>

            </div>

            <!-- SEARCH FILTER -->

            <div class="bg-[#0b1120] border border-cyan-500 rounded-3xl p-6 mt-10">

                <div class="grid md:grid-cols-4 gap-5">

                    <input
                        type="text"
                        id="searchInput"
                        placeholder="Search Token / Name / Mobile / UTR"
                        onkeyup="filterTable()"
                        class="md:col-span-2 px-5 py-4 rounded-2xl bg-black border border-cyan-400 outline-none">

                    <select
                        id="serviceFilter"
                        onchange="filterTable()"
                        class="px-5 py-4 rounded-2xl bg-black border border-cyan-400 outline-none">

                        <option value="all">All PAN Type</option>
                        <option value="New PAN">New PAN</option>
                        <option value="PAN Correction">PAN Correction</option>

                    </select>

                    <select
                        id="statusFilter"
                        onchange="filterTable()"
                        class="px-5 py-4 rounded-2xl bg-black border border-cyan-400 outline-none">

                        <option value="all">All Status</option>
                        <option value="Pending">Pending</option>
                        <option value="Processing">Processing</option>
                        <option value="Completed">Completed</option>
                        <option value="Rejected">Rejected</option>

                    </select>

                </div>

            </div>

            <!-- TABLE -->

            <div class="bg-[#0b1120] border border-cyan-500 rounded-3xl mt-10 overflow-hidden">

                <div class="overflow-x-auto">

                    <table class="w-full text-left" id="applicationTable">

                        <thead class="bg-black text-cyan-400">

                            <tr>
                                <th class="p-5">Token</th>
                                <th class="p-5">Applicant</th>
                                <th class="p-5">Father</th>
                                <th class="p-5">Mobile</th>
                                <th class="p-5">Service</th>
                                <th class="p-5">Amount</th>
                                <th class="p-5">UTR</th>
                                <th class="p-5">Status</th>
                                <th class="p-5">Action</th>
                            </tr>

                        </thead>

                        <tbody>

                            <% if (applications.length === 0) { %>

                                <tr class="border-t border-gray-700">
                                    <td colspan="9" class="p-8 text-center text-gray-400">
                                        Abhi koi PAN application submit nahi hua.
                                    </td>
                                </tr>

                            <% } %>

                            <% applications.forEach((application) => { %>

                                <tr class="border-t border-gray-700 application-row"
                                    data-status="<%= application.status %>"
                                    data-service="<%= application.serviceType %>">

                                    <td class="p-5 font-bold text-cyan-400">
                                        <%= application.tokenNumber %>
                                    </td>

                                    <td class="p-5">
                                        <%= application.applicantName %>
                                    </td>

                                    <td class="p-5">
                                        <%= application.fatherName || "-" %>
                                    </td>

                                    <td class="p-5">
                                        <%= application.phoneNumber %>
                                    </td>

                                    <td class="p-5">
                                        <%= application.serviceType %>
                                    </td>

                                    <td class="p-5">
                                        ₹<%= application.amount %>
                                    </td>

                                    <td class="p-5">
                                        <%= application.utrNumber || "-" %>
                                    </td>

                                    <td class="p-5">

                                        <span class="px-4 py-2 rounded-full
                                            <%= application.status === 'Completed'
                                                ? 'bg-green-500/20 text-green-400'
                                                : application.status === 'Rejected'
                                                ? 'bg-red-500/20 text-red-400'
                                                : application.status === 'Processing'
                                                ? 'bg-blue-500/20 text-blue-400'
                                                : 'bg-yellow-500/20 text-yellow-400' %>">

                                            <%= application.status %>

                                        </span>

                                    </td>

                                    <td class="p-5">

                                        <div class="flex gap-3">

                                            <a href="/admin/application/<%= application.tokenNumber %>"
                                                class="px-4 py-2 bg-cyan-500 rounded-xl text-black font-bold">
                                                View
                                            </a>

                                            <a href="/admin/upload-receiving"
                                                class="px-4 py-2 bg-green-500 rounded-xl text-black font-bold">
                                                Upload
                                            </a>

                                        </div>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                    <div id="noResult"
                        class="hidden p-8 text-center text-red-400 font-bold">
                        Koi matching application nahi mila.
                    </div>

                </div>

            </div>

        </main>

    </div>

    <script>

        function filterTable() {

            const searchValue =
                document.getElementById("searchInput").value.toLowerCase();

            const serviceValue =
                document.getElementById("serviceFilter").value;

            const statusValue =
                document.getElementById("statusFilter").value;

            const rows =
                document.querySelectorAll(".application-row");

            let visibleCount = 0;

            rows.forEach((row) => {

                const rowText =
                    row.innerText.toLowerCase();

                const rowStatus =
                    row.getAttribute("data-status");

                const rowService =
                    row.getAttribute("data-service");

                const searchMatch =
                    rowText.includes(searchValue);

                const serviceMatch =
                    serviceValue === "all" ||
                    rowService === serviceValue;

                const statusMatch =
                    statusValue === "all" ||
                    rowStatus === statusValue;

                if (searchMatch && serviceMatch && statusMatch) {

                    row.classList.remove("hidden");

                    visibleCount++;

                } else {

                    row.classList.add("hidden");

                }

            });

            const noResult =
                document.getElementById("noResult");

            if (visibleCount === 0 && rows.length > 0) {

                noResult.classList.remove("hidden");

            } else {

                noResult.classList.add("hidden");

            }

        }

    </script>

</body>
</html>