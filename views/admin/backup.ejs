<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Backup & Export</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#050816] text-white">

    <div class="flex min-h-screen">

        <!-- SIDEBAR -->

        <aside class="w-72 bg-black border-r border-cyan-500 p-6 hidden md:block">

            <h1 class="text-4xl font-bold text-cyan-400">
                CyberPoint
            </h1>

            <p class="text-gray-400 mt-2">
                Admin Panel
            </p>

            <div class="mt-12 space-y-4">

                <a href="/admin/dashboard"
                    class="block px-5 py-4 rounded-2xl border border-cyan-500 hover:bg-cyan-500 hover:text-black transition">
                    Dashboard
                </a>

                <a href="/admin/otp-requests"
                    class="block px-5 py-4 rounded-2xl border border-cyan-500 hover:bg-cyan-500 hover:text-black transition">
                    Live OTP Requests
                </a>

                <a href="/admin/aadhar-applications"
                    class="block px-5 py-4 rounded-2xl border border-cyan-500 hover:bg-cyan-500 hover:text-black transition">
                    Aadhar Applications
                </a>

                <a href="/admin/pan-applications"
                    class="block px-5 py-4 rounded-2xl border border-cyan-500 hover:bg-cyan-500 hover:text-black transition">
                    PAN Applications
                </a>

                <a href="/admin/upload-receiving"
                    class="block px-5 py-4 rounded-2xl border border-cyan-500 hover:bg-cyan-500 hover:text-black transition">
                    Upload Receiving
                </a>

                <a href="/admin/backup"
                    class="block px-5 py-4 rounded-2xl bg-cyan-500 text-black font-bold">
                    Backup & Export
                </a>

                <a href="/admin/settings"
                    class="block px-5 py-4 rounded-2xl border border-cyan-500 hover:bg-cyan-500 hover:text-black transition">
                    Settings
                </a>

                <a href="/admin/logout"
                    class="block px-5 py-4 rounded-2xl border border-red-500 text-red-400 hover:bg-red-500 hover:text-white transition">
                    Logout
                </a>

            </div>

        </aside>

        <!-- MAIN -->

        <main class="flex-1 p-6 md:p-10">

            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">

                <div>

                    <h2 class="text-4xl font-bold text-cyan-400">
                        Backup & Export
                    </h2>

                    <p class="text-gray-400 mt-3">
                        Data safe rakhne ke liye regular backup download karein.
                    </p>

                </div>

                <a href="/admin/dashboard"
                    class="px-6 py-3 bg-cyan-500 rounded-xl text-black font-bold text-center">
                    Back Dashboard
                </a>

            </div>

            <!-- STATS -->

            <div class="grid md:grid-cols-2 gap-8 mt-12">

                <div class="bg-[#0b1120] border border-cyan-500 rounded-3xl p-8">

                    <p class="text-gray-400">
                        Total Applications
                    </p>

                    <h3 class="text-5xl font-bold text-cyan-400 mt-4">
                        <%= totalApplications %>
                    </h3>

                </div>

                <div class="bg-[#0b1120] border border-green-500 rounded-3xl p-8">

                    <p class="text-gray-400">
                        Total Revenue
                    </p>

                    <h3 class="text-5xl font-bold text-green-400 mt-4">
                        ₹<%= totalRevenue %>
                    </h3>

                </div>

            </div>

            <!-- DOWNLOAD BOX -->

            <div class="bg-[#0b1120] border border-cyan-500 rounded-3xl p-8 mt-12">

                <h3 class="text-3xl font-bold text-cyan-400">
                    Download Backup
                </h3>

                <p class="text-gray-400 mt-3">
                    JSON backup full restore ke liye useful hai. CSV export Excel me open karne ke liye useful hai.
                </p>

                <div class="grid md:grid-cols-2 gap-6 mt-8">

                    <a href="/admin/backup/download-json"
                        class="block text-center px-8 py-5 bg-cyan-500 rounded-2xl text-black font-bold hover:bg-cyan-600 transition">

                        Download JSON Backup

                    </a>

                    <a href="/admin/backup/export-csv"
                        class="block text-center px-8 py-5 bg-green-500 rounded-2xl text-black font-bold hover:bg-green-600 transition">

                        Export CSV For Excel

                    </a>

                </div>

            </div>

            <!-- GUIDE -->

            <div class="bg-black border border-yellow-500 rounded-3xl p-8 mt-12 mb-10">

                <h3 class="text-3xl font-bold text-yellow-400">
                    Important Backup Guide
                </h3>

                <div class="mt-6 space-y-4 text-gray-300">

                    <p>
                        ✅ Daily kaam khatam hone ke baad ek baar JSON backup download karo.
                    </p>

                    <p>
                        ✅ JSON file ko Google Drive / Pendrive / Phone me safe rakho.
                    </p>

                    <p>
                        ✅ Uploaded documents ke liye ye folder copy karna zaroori hai:
                    </p>

                    <div class="bg-[#0b1120] border border-cyan-500 rounded-2xl p-5 text-cyan-400 font-bold">
                        public/uploads
                    </div>

                    <p>
                        ✅ Full project backup ke liye complete project folder copy karo:
                    </p>

                    <div class="bg-[#0b1120] border border-cyan-500 rounded-2xl p-5 text-cyan-400 font-bold">
                        CYBER-POINT
                    </div>

                    <p>
                        ✅ Best practice: har raat ek folder copy banao:
                    </p>

                    <div class="bg-[#0b1120] border border-cyan-500 rounded-2xl p-5 text-cyan-400 font-bold">
                        CYBER-POINT-BACKUP-DATE
                    </div>

                </div>

            </div>

        </main>

    </div>

</body>
</html>